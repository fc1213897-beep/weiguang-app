# 复制为 .env.local 并填入真实值

# 站点地址（须与小程序 config.js 中 API_BASE_PROD 一致）
NEXT_PUBLIC_APP_URL=https://www.weiguanglife.top

# Server Action 加密密钥（自托管必配，构建前写入 .env，避免 rebuild 后报 Failed to find Server Action）
# 生成：openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=your-base64-key-here

# 微信小程序（须与 miniprogram/project.config.json 中 appid 一致）
NEXT_PUBLIC_WX_APPID=wx3a960e108120a74a
WX_APP_SECRET=your-wx-app-secret
WX_MP_LOGIN_PAGE=pages/login/login
WX_MP_ENV_VERSION=develop

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 小光 AI（通义千问 DashScope）
DASHSCOPE_API_KEY=sk-your-key-here
