.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
  background: transparent;
  pointer-events: none;
}

.tab-bar-inner {
  pointer-events: auto;
  margin: 0 24rpx 16rpx;
  padding: 12rpx 8rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255, 253, 247, 0.98);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(120, 53, 15, 0.1);
  border: 1rpx solid rgba(254, 215, 170, 0.5);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.tab-icon-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  transition: transform 0.25s ease;
}

.tab-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(251, 191, 36, 0.45) 0%,
    rgba(251, 146, 60, 0.2) 45%,
    transparent 70%
  );
  animation: glow-pulse 2.2s ease-in-out infinite;
  pointer-events: none;
}

@keyframes glow-pulse {
  0%,
  100% {
    opacity: 0.65;
    transform: translate(-50%, -50%) scale(0.92);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.08);
  }
}

.tab-icon {
  position: relative;
  z-index: 1;
  font-size: 36rpx;
  line-height: 1;
  transition: transform 0.25s ease, filter 0.25s ease;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #a8a29e;
  transition: color 0.2s ease;
}

.tab-item.active .tab-icon-wrap {
  background: linear-gradient(145deg, #fff7ed, #ffedd5);
  transform: scale(1.06);
  box-shadow: 0 0 20rpx rgba(251, 146, 60, 0.35);
}

.tab-item.active .tab-icon {
  transform: scale(1.08);
  filter: drop-shadow(0 0 8rpx rgba(251, 191, 36, 0.6));
}

.tab-item.active .tab-text {
  color: #c2410c;
  font-weight: 600;
}
