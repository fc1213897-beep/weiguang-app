<view class="chat-page">
  <view class="error-banner" wx:if="{{loginError}}">
    <text class="error-text">{{loginError}}</text>
    <text class="error-retry" bindtap="onRetryLogin">去登录</text>
  </view>

  <view class="guest-banner card-soft" wx:if="{{!loggedIn}}">
    <text class="guest-banner-text">体验模式：可先浏览，发送消息需登录</text>
    <text class="guest-banner-login" bindtap="onGoLogin">登录</text>
  </view>

  <view class="chat-header card-soft">
    <text class="header-emoji">✨</text>
    <view class="header-text">
      <text class="header-title">小光</text>
      <text class="header-sub">温柔陪伴你的学习搭子</text>
    </view>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-dot"></view>
    <text class="loading-text">加载中…</text>
  </view>

  <scroll-view
    class="messages"
    scroll-y
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation
    show-scrollbar="{{false}}"
  >
    <view
      class="msg-row {{item.role === 'user' ? 'user' : 'assistant'}}"
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{index}}"
    >
      <view class="avatar" wx:if="{{item.role === 'assistant'}}">✨</view>
      <view class="bubble">
        <text class="bubble-text">{{item.content}}</text>
        <text class="expense-hint" wx:if="{{item.expense_recorded}}">💰 已记入今日账本</text>
        <view class="task-suggest-card" wx:if="{{item.tasks_suggested && item.tasks_suggested.length}}">
          <text class="task-suggest-title">建议加入今日</text>
          <text
            class="task-suggest-line"
            wx:for="{{item.tasks_suggested}}"
            wx:for-item="task"
            wx:key="text"
          >· {{task.text}}</text>
          <view
            class="task-suggest-btn"
            data-index="{{index}}"
            bindtap="onAddSuggestedTasks"
          >加入今日计划</view>
        </view>
      </view>
      <view class="avatar user-avatar" wx:if="{{item.role === 'user'}}">我</view>
    </view>
    <view class="msg-row assistant" wx:if="{{sending}}">
      <view class="avatar">✨</view>
      <view class="bubble typing">
        <text class="bubble-text">小光正在想…</text>
      </view>
    </view>
    <view class="scroll-bottom" id="scroll-bottom"></view>
  </scroll-view>

  <view class="input-bar">
    <input
      class="chat-input"
      placeholder="{{loggedIn ? '和小光说说，或「午饭 35」记账' : '登录后和小光聊天、记账'}}"
      placeholder-class="placeholder"
      value="{{input}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="onSend"
      disabled="{{sending}}"
    />
    <button
      class="btn-send btn-primary"
      bindtap="onSend"
      loading="{{sending}}"
      disabled="{{sending}}"
    >
      发送
    </button>
  </view>
</view>
