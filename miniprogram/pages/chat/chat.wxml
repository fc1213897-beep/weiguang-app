<view class="chat-page">
  <view class="error-banner" wx:if="{{loginError}}">
    <text class="error-text">{{loginError}}</text>
    <text class="error-retry" bindtap="onRetryLogin">重试</text>
  </view>

  <view class="chat-header card-soft">
    <text class="header-emoji">✨</text>
    <view class="header-text">
      <text class="header-title">小光</text>
      <text class="header-sub">温柔陪伴你的学习搭子</text>
    </view>
  </view>

  <scroll-view
    class="messages"
    scroll-y
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation
    show-scrollbar="{{false}}"
  >
    <view
      class="msg-row {{item.role === 'user' ? 'user' : 'assistant'}}"
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{index}}"
    >
      <view class="avatar" wx:if="{{item.role === 'assistant'}}">✨</view>
      <view class="bubble">
        <text class="bubble-text">{{item.content}}</text>
      </view>
      <view class="avatar user-avatar" wx:if="{{item.role === 'user'}}">我</view>
    </view>
    <view class="msg-row assistant" wx:if="{{sending}}">
      <view class="avatar">✨</view>
      <view class="bubble typing">
        <text class="bubble-text">小光正在想…</text>
      </view>
    </view>
    <view class="scroll-bottom" id="scroll-bottom"></view>
  </scroll-view>

  <view class="input-bar">
    <input
      class="chat-input"
      placeholder="和小光说说…"
      placeholder-class="placeholder"
      value="{{input}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="onSend"
      disabled="{{sending || !loggedIn}}"
    />
    <button
      class="btn-send btn-primary"
      bindtap="onSend"
      loading="{{sending}}"
      disabled="{{sending || !loggedIn}}"
    >
      发送
    </button>
  </view>
</view>
