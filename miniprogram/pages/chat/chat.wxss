@import "../../app.wxss";

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #fff7ed 0%, #ffffff 40%);
  box-sizing: border-box;
}

.messages {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 20rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-row.assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 82%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.user .bubble {
  background: #fed7aa;
  color: #292524;
}

.assistant .bubble {
  background: #fff;
  color: #44403c;
  box-shadow: 0 4rpx 16rpx rgba(251, 146, 60, 0.12);
}

.typing .bubble-text {
  color: #a8a29e;
}

.bubble-text {
  word-break: break-word;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #fde68a;
}

.chat-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #fafaf9;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.btn-send {
  background: #f97316;
  color: #fff;
  border: none;
}
