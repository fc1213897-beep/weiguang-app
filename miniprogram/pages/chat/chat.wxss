@import "../../styles/theme.wxss";

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(165deg, #fff7ed 0%, #fffbeb 40%, #ffffff 100%);
  box-sizing: border-box;
}

.error-banner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin: 16rpx 28rpx 0;
  padding: 20rpx 24rpx;
  background: #fef2f2;
  border-radius: 16rpx;
  border: 1rpx solid #fecaca;
  flex-shrink: 0;
}

.error-text {
  flex: 1;
  font-size: 24rpx;
  color: #b91c1c;
  line-height: 1.5;
}

.error-retry {
  font-size: 26rpx;
  color: #ea580c;
  font-weight: 600;
}

.chat-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 16rpx 28rpx;
  padding: 24rpx 28rpx;
  flex-shrink: 0;
}

.header-emoji {
  font-size: 48rpx;
}

.header-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #292524;
}

.header-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #78716c;
}

.messages {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 24rpx;
  gap: 12rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #ffedd5, #fed7aa);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.user-avatar {
  font-size: 22rpx;
  color: #c2410c;
  font-weight: 600;
  background: #fff7ed;
}

.bubble {
  max-width: 68%;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
}

.user .bubble {
  background: linear-gradient(135deg, #fdba74, #fb923c);
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.assistant .bubble {
  background: #fff;
  color: #44403c;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(251, 146, 60, 0.1);
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-word;
}

.typing .bubble-text {
  color: #a8a29e;
}

.scroll-bottom {
  height: 24rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx calc(120rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  border-top: 1rpx solid rgba(254, 215, 170, 0.5);
  flex-shrink: 0;
}

.chat-input {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  background: #fafaf9;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.placeholder {
  color: #d6d3d1;
}

.btn-send {
  min-width: 120rpx !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  padding: 0 24rpx !important;
  font-size: 28rpx !important;
}
