<view class="page">
  <view class="card">
    <text class="title">微光 · 扫码登录</text>
    <text class="desc">确认后，电脑网页将自动完成登录</text>

    <view class="scene-box" wx:if="{{scene}}">
      <text class="scene-label">场景值 scene</text>
      <text class="scene-value">{{scene}}</text>
    </view>

    <view class="scene-box warn" wx:else>
      <text class="warn-title">当前没有 scene（正常情况）</text>
      <text class="warn-line">你是直接「编译」打开的本页，不是扫电脑上的小程序码，所以没有场景值。</text>
      <text class="warn-line warn-step">① 电脑浏览器打开 localhost:3000/settings</text>
      <text class="warn-line warn-step">② 点「微信扫码登录」出现小程序码</text>
      <text class="warn-line warn-step">③ 用微信扫该码进入本页（不要点普通编译）</text>
      <text class="warn-line warn-step">④ 或见下方「开发调试」粘贴电脑上的 scene</text>
    </view>

    <!-- 开发调试：电脑已出码但未扫码时，可粘贴 scene 测试 -->
    <view class="dev-box" wx:if="{{!scene && !authorized}}">
      <text class="dev-title">开发调试（可选）</text>
      <input
        class="dev-input"
        placeholder="粘贴电脑网页上的 scene"
        value="{{devSceneInput}}"
        bindinput="onDevSceneInput"
      />
      <button class="btn-dev" size="mini" bindtap="applyDevScene">填入 scene</button>
    </view>

    <button
      class="btn-login {{authorized ? 'done' : ''}}"
      bindtap="handleWxLogin"
      loading="{{loading}}"
      disabled="{{loading || !scene}}"
    >
      {{authorized ? '已授权成功' : '允许登录'}}
    </button>

    <text class="hint" wx:if="{{authorized}}">请回到电脑浏览器查看登录状态</text>
  </view>
</view>
