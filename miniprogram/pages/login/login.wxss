.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff7ed 0%, #ffffff 60%);
}

.card {
  padding: 48rpx 40rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(251, 146, 60, 0.12);
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #292524;
}

.desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #78716c;
}

.scene-box {
  margin-top: 40rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fafaf9;
}

.scene-box.warn {
  background: #fef3c7;
  color: #92400e;
  font-size: 26rpx;
}

.warn-title {
  display: block;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.warn-line {
  display: block;
  line-height: 1.5;
  margin-top: 8rpx;
}

.warn-step {
  padding-left: 8rpx;
}

.dev-box {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 1rpx dashed #d6d3d1;
  background: #fafaf9;
}

.dev-title {
  display: block;
  font-size: 24rpx;
  color: #78716c;
  margin-bottom: 16rpx;
}

.dev-input {
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 24rpx;
  border: 1rpx solid #e7e5e4;
}

.btn-dev {
  margin-top: 16rpx;
  background: #fff7ed;
  color: #c2410c;
}

.scene-label {
  display: block;
  font-size: 22rpx;
  color: #a8a29e;
}

.scene-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #57534e;
  word-break: break-all;
}

.btn-login {
  margin-top: 48rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
  background: #22c55e;
  border: none;
}

.btn-login.done {
  background: #86efac;
  color: #166534;
}

.btn-login[disabled] {
  background: #d6d3d1;
  color: #fff;
}

.hint {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #22c55e;
}
