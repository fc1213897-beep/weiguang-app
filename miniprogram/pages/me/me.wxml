<view class="page-wrap">
  <view class="profile-hero card-soft">
    <view class="profile-glow"></view>
    <text class="profile-emoji">✨</text>
    <text class="profile-name">微光</text>
    <text class="profile-desc" wx:if="{{email}}">{{email}}</text>
    <text class="profile-desc" wx:else>微信已登录 · 与 PC 数据同步</text>
  </view>

  <view class="menu-card card-soft">
    <navigator url="/pages/login/login?hint=pc" class="menu-row">
      <view class="menu-left">
        <text class="menu-icon">💻</text>
        <text class="menu-label">帮电脑扫码登录</text>
      </view>
      <text class="menu-arrow">›</text>
    </navigator>
    <view class="menu-divider"></view>
    <view class="menu-row" bindtap="onLogout">
      <view class="menu-left">
        <text class="menu-icon">🚪</text>
        <text class="menu-label danger">退出登录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="tip-card card-soft">
    <text class="tip-title">💡 和 PC 搭配使用</text>
    <text class="tip-line">手机：记任务、记账、跟小光聊天</text>
    <text class="tip-line">电脑：打开 weiguanglife.top 看统计与成长空间</text>
  </view>

  <view class="page-bottom-spacer"></view>
</view>
