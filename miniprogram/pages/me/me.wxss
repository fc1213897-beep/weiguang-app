@import "../../app.wxss";

.page {
  padding: 24rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #fff7ed 0%, #ffffff 50%);
  box-sizing: border-box;
}

.profile {
  text-align: center;
  padding: 48rpx 32rpx;
}

.avatar {
  font-size: 72rpx;
  display: block;
}

.name {
  display: block;
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #292524;
}

.email {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #78716c;
  word-break: break-all;
}

.email.muted {
  color: #a8a29e;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f4;
  font-size: 30rpx;
  color: #44403c;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #d6d3d1;
}

.danger {
  color: #dc2626;
}

.hint {
  display: block;
  margin-top: 32rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #a8a29e;
  line-height: 1.6;
  text-align: center;
}
