@import "../../styles/theme.wxss";

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 56rpx 32rpx 48rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.profile-glow {
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(251, 146, 60, 0.25) 0%, transparent 70%);
  pointer-events: none;
}

.profile-emoji {
  position: relative;
  font-size: 80rpx;
  display: block;
}

.profile-name {
  position: relative;
  display: block;
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #292524;
}

.profile-desc {
  position: relative;
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #78716c;
  word-break: break-all;
  padding: 0 24rpx;
}

.login-card {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

.login-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #292524;
}

.login-card-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #78716c;
  line-height: 1.55;
}

.btn-login {
  margin-top: 28rpx;
  background: #ea580c;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-login::after {
  border: none;
}

.notify-section {
  padding: 20rpx 28rpx 8rpx;
}

.notify-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #292524;
}

.notify-desc {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #a8a29e;
}

.notify-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.notify-label {
  font-size: 26rpx;
  color: #44403c;
}

.notify-time-value {
  font-size: 28rpx;
  color: #ea580c;
  font-weight: 600;
  padding: 8rpx 16rpx;
  background: #fff7ed;
  border-radius: 12rpx;
}

.menu-card {
  padding: 8rpx 0;
  margin-bottom: 24rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-text-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-sub {
  font-size: 22rpx;
  color: #a8a29e;
}

.menu-icon {
  font-size: 36rpx;
}

.menu-label {
  font-size: 30rpx;
  color: #44403c;
}

.menu-label.danger {
  color: #dc2626;
}

.menu-arrow {
  font-size: 32rpx;
  color: #d6d3d1;
}

.menu-divider {
  height: 1rpx;
  margin: 0 28rpx;
  background: #f5f5f4;
}

.tip-card {
  padding: 28rpx 32rpx;
}

.tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #44403c;
  margin-bottom: 16rpx;
}

.tip-line {
  display: block;
  font-size: 26rpx;
  color: #78716c;
  line-height: 1.6;
  margin-top: 8rpx;
}

.tip-actions {
  margin-top: 20rpx;
}

.tip-action {
  display: inline-flex;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #fff7ed;
}

.tip-action-text {
  font-size: 24rpx;
  color: #c2410c;
}

.version-footer {
  margin-top: 32rpx;
  text-align: center;
}

.version-text {
  font-size: 22rpx;
  color: #d6d3d1;
}

.page-bottom-spacer {
  height: var(--mp-page-bottom);
}
