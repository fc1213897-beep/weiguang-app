@import "../../styles/theme.wxss";

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 56rpx 32rpx 48rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.profile-glow {
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(251, 146, 60, 0.25) 0%, transparent 70%);
  pointer-events: none;
}

.profile-emoji {
  position: relative;
  font-size: 80rpx;
  display: block;
}

.profile-name {
  position: relative;
  display: block;
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #292524;
}

.profile-desc {
  position: relative;
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #78716c;
  word-break: break-all;
  padding: 0 24rpx;
}

.menu-card {
  padding: 8rpx 0;
  margin-bottom: 24rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon {
  font-size: 36rpx;
}

.menu-label {
  font-size: 30rpx;
  color: #44403c;
}

.menu-label.danger {
  color: #dc2626;
}

.menu-arrow {
  font-size: 32rpx;
  color: #d6d3d1;
}

.menu-divider {
  height: 1rpx;
  margin: 0 28rpx;
  background: #f5f5f4;
}

.tip-card {
  padding: 28rpx 32rpx;
}

.tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #44403c;
  margin-bottom: 16rpx;
}

.tip-line {
  display: block;
  font-size: 26rpx;
  color: #78716c;
  line-height: 1.6;
  margin-top: 8rpx;
}

.page-bottom-spacer {
  height: var(--tab-bar-clearance);
}
