@import "../../styles/theme.wxss";

.error-banner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  background: #fef2f2;
  border-radius: 16rpx;
  border: 1rpx solid #fecaca;
}

.error-text {
  flex: 1;
  font-size: 24rpx;
  color: #b91c1c;
  line-height: 1.5;
}

.error-retry {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #ea580c;
  font-weight: 600;
}

.hero {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  background: #ffedd5;
  color: #c2410c;
  border-radius: 999rpx;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.date-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff7ed;
  border-radius: 16rpx;
}

.nav-arrow {
  font-size: 36rpx;
  color: #a8a29e;
  line-height: 1;
}

.date-main {
  font-size: 40rpx;
  font-weight: 700;
  color: #292524;
}

.progress-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #ffedd5;
}

.progress-item {
  flex: 1;
  text-align: center;
}

.progress-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #292524;
}

.progress-item.done .progress-num {
  color: #16a34a;
}

.progress-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #a8a29e;
}

.progress-divider {
  width: 1rpx;
  height: 56rpx;
  background: #fde68a;
}

.add-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.add-hint {
  display: block;
  font-size: 24rpx;
  color: #78716c;
  margin-bottom: 16rpx;
}

.add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #fafaf9;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #292524;
}

.placeholder {
  color: #d6d3d1;
}

.btn-add {
  flex-shrink: 0;
  min-width: 140rpx !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  padding: 0 28rpx !important;
  font-size: 28rpx !important;
}

.empty {
  padding: 56rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.empty-emoji {
  font-size: 64rpx;
  display: block;
}

.empty-title {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #44403c;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #a8a29e;
  line-height: 1.5;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #fdba74;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #22c55e;
  border-color: #22c55e;
}

.check-mark {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.task-title {
  flex: 1;
  font-size: 30rpx;
  color: #292524;
  line-height: 1.45;
}

.task-card.is-done .task-title {
  color: #a8a29e;
  text-decoration: line-through;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #fb923c;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.4;
    transform: scale(0.9);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #a8a29e;
}

.page-bottom-spacer {
  height: var(--tab-bar-clearance);
}
