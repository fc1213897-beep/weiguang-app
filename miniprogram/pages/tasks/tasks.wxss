@import "../../styles/theme.wxss";

/* 页面：奶油暖白底 */
.tasks-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx var(--mp-page-bottom);
  background: #fffdf7;
  position: relative;
}

.card-elevated {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(120, 53, 15, 0.06), 0 1rpx 4rpx rgba(251, 146, 60, 0.08);
  border: 1rpx solid rgba(254, 215, 170, 0.35);
}

.error-banner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  background: #fef2f2;
  border-radius: 20rpx;
  border: 1rpx solid #fecaca;
}

.error-text {
  flex: 1;
  font-size: 24rpx;
  color: #b91c1c;
  line-height: 1.55;
}

.error-retry {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #ea580c;
  font-weight: 600;
}

.guest-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
}

.guest-banner-text {
  flex: 1;
  font-size: 24rpx;
  color: #9a3412;
  line-height: 1.55;
}

.guest-banner-login {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #fb923c, #ea580c);
  border-radius: 999rpx;
}

/* —— 顶部日期区 —— */
.hero-card {
  padding: 32rpx 28rpx 28rpx;
  margin-bottom: 20rpx;
}

.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.eyebrow-label {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: #ea580c;
}

.eyebrow-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  background: linear-gradient(135deg, #ffedd5, #fed7aa);
  color: #c2410c;
  border-radius: 999rpx;
}

.date-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  gap: 12rpx;
}

.date-nav-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff7ed;
  border-radius: 20rpx;
  transition: transform 0.2s ease, background 0.2s ease;
}

.date-nav-pressed {
  transform: scale(0.92);
  background: #ffedd5;
}

.date-nav-btn.nav-bump {
  animation: nav-bump 0.35s ease;
}

@keyframes nav-bump {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(0.88);
  }
  100% {
    transform: scale(1);
  }
}

.date-nav-icon {
  font-size: 40rpx;
  color: #78716c;
  line-height: 1;
  font-weight: 300;
}

.date-center {
  flex: 1;
  text-align: center;
}

.date-center.date-slide-anim {
  animation: date-slide 0.32s ease;
}

@keyframes date-slide {
  0% {
    opacity: 0.4;
    transform: translateY(8rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 视觉中心：日期最大字号 */
.date-display {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #1c1917;
  line-height: 1.2;
  letter-spacing: -0.02em;
}

.date-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a8a29e;
  letter-spacing: 0.04em;
}

/* —— 进度环 + 统计 —— */
.stats-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #ffedd5;
}

.progress-ring-wrap {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.progress-ring {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: ring-pop 0.5s ease;
}

@keyframes ring-pop {
  0% {
    transform: scale(0.92);
    opacity: 0.6;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.progress-ring-hole {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #fffdf7;
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding-top: 28rpx;
  box-sizing: border-box;
}

.ring-percent {
  font-size: 40rpx;
  font-weight: 700;
  color: #16a34a;
  line-height: 1;
}

.ring-unit {
  font-size: 22rpx;
  font-weight: 600;
  color: #86efac;
  margin-left: 2rpx;
}

.ring-caption {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #a8a29e;
}

.stats-cards {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stat-card {
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.stat-done {
  background: linear-gradient(135deg, #f0fdf4, #dcfce7);
}

.stat-todo {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.stat-done .stat-num {
  color: #16a34a;
}

.stat-todo .stat-num {
  color: #ea580c;
}

.stat-label {
  font-size: 24rpx;
  color: #78716c;
}

/* —— 今日建议条 —— */
.insight-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #fffbeb 0%, #ffffff 70%);
}

.insight-strip-left {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.insight-strip-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.insight-strip-text {
  font-size: 24rpx;
  color: #57534e;
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.insight-strip-loading { color: #a8a29e; }
.insight-strip-placeholder { color: #d6d3d1; }

.insight-strip-link {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #ea580c;
  font-weight: 600;
}

/* —— 快捷栏 —— */
.quick-bar {
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.quick-suggest {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #ffedd5;
}

.quick-pressed {
  opacity: 0.75;
}

.quick-suggest-icon {
  font-size: 40rpx;
}

.quick-suggest-text {
  flex: 1;
}

.quick-suggest-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #292524;
}

.quick-suggest-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #a8a29e;
}

.quick-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.quick-chips-inline {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 8rpx;
}

.quick-chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  font-size: 22rpx;
  color: #57534e;
  background: #fffdf7;
  border-radius: 999rpx;
  border: 1rpx solid #ffedd5;
}

.chip-pressed {
  transform: scale(0.96);
  opacity: 0.85;
}

/* —— 空状态小芽 —— */
.empty-card {
  padding: 48rpx 32rpx 56rpx;
  text-align: center;
  margin-bottom: calc(var(--mp-fab-size) + var(--mp-fab-gap));
}

.empty-tap {
  animation: empty-breathe 3s ease-in-out infinite;
}

@keyframes empty-breathe {
  0%,
  100% {
    transform: translateY(0);
    box-shadow: 0 4rpx 24rpx rgba(120, 53, 15, 0.06);
  }
  50% {
    transform: translateY(-6rpx);
    box-shadow: 0 12rpx 36rpx rgba(251, 146, 60, 0.12);
  }
}

.empty-pressed {
  transform: scale(0.98);
  opacity: 0.92;
}

.sprout-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
}

.sprout-pot {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 36rpx;
  background: #fed7aa;
  border-radius: 8rpx 8rpx 16rpx 16rpx;
}

.sprout-stem {
  position: absolute;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 48rpx;
  background: #86efac;
  border-radius: 4rpx;
  animation: stem-grow 2s ease-in-out infinite;
}

@keyframes stem-grow {
  0%,
  100% {
    height: 44rpx;
  }
  50% {
    height: 52rpx;
  }
}

.sprout-leaf {
  position: absolute;
  width: 28rpx;
  height: 18rpx;
  background: #4ade80;
  border-radius: 50% 50% 50% 0;
}

.sprout-leaf-l {
  bottom: 58rpx;
  left: 28rpx;
  transform: rotate(-35deg);
  animation: leaf-sway-l 2.5s ease-in-out infinite;
}

.sprout-leaf-r {
  bottom: 62rpx;
  right: 28rpx;
  transform: rotate(35deg) scaleX(-1);
  animation: leaf-sway-r 2.5s ease-in-out infinite 0.3s;
}

@keyframes leaf-sway-l {
  0%,
  100% {
    transform: rotate(-35deg);
  }
  50% {
    transform: rotate(-25deg);
  }
}

@keyframes leaf-sway-r {
  0%,
  100% {
    transform: rotate(35deg) scaleX(-1);
  }
  50% {
    transform: rotate(25deg) scaleX(-1);
  }
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #44403c;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #a8a29e;
  line-height: 1.55;
}

.empty-cta {
  display: inline-block;
  margin-top: 28rpx;
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #fb923c, #ea580c);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(234, 88, 12, 0.28);
}

/* —— 任务列表 —— */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #fdba74;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: #22c55e;
  border-color: #22c55e;
  transform: scale(1.05);
}

.check-mark {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.task-body {
  flex: 1;
  min-width: 0;
}

.task-title {
  display: block;
  font-size: 30rpx;
  color: #292524;
  line-height: 1.5;
  word-break: break-word;
}

.task-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a8a29e;
  line-height: 1.4;
}

.task-remind-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ea580c;
}

.task-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.btn-remind {
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  color: #c2410c;
  background: #fff7ed;
  border-radius: 14rpx;
  border: 1rpx solid #fed7aa;
}

.btn-remind-guest {
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  color: #a8a29e;
  background: #fafaf9;
  border-radius: 14rpx;
  border: 1rpx solid #e7e5e4;
}

.btn-remind-clear {
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  color: #78716c;
  background: #fafaf9;
  border-radius: 12rpx;
}

.remind-picker-anchor {
  position: fixed;
  left: -9999px;
  width: 1px;
  height: 1px;
  opacity: 0;
}

.task-card.is-done .task-title {
  color: #a8a29e;
  text-decoration: line-through;
}

.btn-delete {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #dc2626;
  background: #fef2f2;
  border-radius: 16rpx;
  border: 1rpx solid #fecaca;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #fb923c;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.4;
    transform: scale(0.9);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #a8a29e;
}

.page-bottom-spacer {
  height: 0;
}

/* —— FAB —— */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: var(--mp-fab-bottom);
  z-index: 900;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #fb923c 0%, #ea580c 100%);
  box-shadow: 0 12rpx 40rpx rgba(234, 88, 12, 0.38);
  transition: transform 0.15s ease;
}

.fab-hover,
.fab-pressed {
  transform: scale(0.94);
}

.fab-icon {
  font-size: 44rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.fab-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 600;
  margin-top: -4rpx;
}

/* —— 庆祝动效 —— */
.celebrate-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 11000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(28, 25, 23, 0.25);
  pointer-events: none;
}

.celebrate-card {
  padding: 40rpx 48rpx;
  background: #fff;
  border-radius: 28rpx;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(251, 146, 60, 0.25);
  animation: celebrate-in 0.4s ease;
}

@keyframes celebrate-in {
  0% {
    opacity: 0;
    transform: scale(0.85) translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.celebrate-emoji {
  font-size: 72rpx;
  display: block;
}

.celebrate-wave {
  animation: wave-hand 0.6s ease-in-out 2;
  display: inline-block;
}

@keyframes wave-hand {
  0%,
  100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(20deg);
  }
  75% {
    transform: rotate(-12deg);
  }
}

.celebrate-title {
  display: block;
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #292524;
}

.celebrate-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #78716c;
}

/* —— 弹层 —— */
.plan-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(28, 25, 23, 0);
  display: flex;
  align-items: flex-end;
  transition: background 0.28s ease;
}

.plan-modal-mask.mask-show {
  background: rgba(28, 25, 23, 0.38);
}

.plan-modal-sheet {
  width: 100%;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  background: #fffdf9;
  border-radius: 32rpx 32rpx 0 0;
  border: 1rpx solid #ffedd5;
  box-shadow: 0 -12rpx 48rpx rgba(120, 53, 15, 0.14);
  transform: translateY(100%);
  transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
}

.plan-modal-sheet.sheet-show {
  transform: translateY(0);
}

.plan-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #ffedd5;
  flex-shrink: 0;
}

.plan-modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #292524;
}

.plan-modal-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #78716c;
  line-height: 1.45;
}

.plan-modal-close {
  font-size: 36rpx;
  color: #a8a29e;
  padding: 8rpx 16rpx;
}

.close-pressed {
  opacity: 0.5;
}

.plan-modal-body {
  flex: 1;
  min-height: 200rpx;
  max-height: 58vh;
}

.plan-form {
  padding: 24rpx 32rpx 40rpx;
}

.split-box {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
}

.split-textarea {
  width: 100%;
  min-height: 120rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #fff;
  font-size: 26rpx;
}

.btn-split {
  margin-top: 16rpx;
  padding: 20rpx;
  text-align: center;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fb923c, #ea580c);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.split-preview-box {
  padding: 24rpx 32rpx 40rpx;
}

.split-summary {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #78716c;
  line-height: 1.5;
}

.split-preview-item {
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #fde68a;
  font-size: 26rpx;
  color: #44403c;
}

.split-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-split-cancel,
.btn-split-confirm {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.btn-split-cancel {
  background: #f5f5f4;
  color: #57534e;
}

.btn-split-confirm {
  background: linear-gradient(135deg, #fb923c, #ea580c);
  color: #fff;
  font-weight: 600;
}

.btn-disabled {
  opacity: 0.55;
}

.plan-form-flash {
  animation: plan-flash 0.65s ease-out;
}

@keyframes plan-flash {
  0% {
    box-shadow: 0 0 0 0 rgba(251, 191, 136, 0.45);
  }
  100% {
    box-shadow: 0 0 0 24rpx rgba(251, 191, 136, 0);
  }
}

.suggest-box {
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 237, 213, 0.45);
  border: 1rpx solid #fde68a;
}

.suggest-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.suggest-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #c2410c;
}

.suggest-refresh {
  font-size: 22rpx;
  color: #a8a29e;
}

.suggest-text {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #57534e;
  line-height: 1.55;
}

.btn-adopt {
  margin-top: 16rpx;
  padding: 14rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #c2410c;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #fed7aa;
}

.field-block {
  margin-top: 28rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #78716c;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #ffedd5;
  font-size: 28rpx;
  color: #292524;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: #57534e;
  background: #fff;
  border-radius: 999rpx;
  border: 1rpx solid #ffedd5;
}

.chip-active {
  background: #fb923c;
  color: #fff;
  border-color: #fb923c;
}

.chip-active-priority {
  background: #fef3c7;
  color: #b45309;
  border-color: #fde68a;
}

.priority-row .chip {
  flex: 1;
  text-align: center;
  min-width: 140rpx;
}

.plan-modal-footer {
  flex-shrink: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ffedd5;
  background: rgba(255, 255, 255, 0.98);
}

.btn-submit-plan {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #fb923c 0%, #ea580c 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(234, 88, 12, 0.28);
}

.submit-pressed {
  opacity: 0.88;
  transform: scale(0.98);
}

.btn-disabled {
  opacity: 0.65;
}

.placeholder {
  color: #d6d3d1;
}
