@import "../../app.wxss";

.page {
  padding: 24rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff7ed 0%, #ffffff 50%);
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 24rpx rgba(251, 146, 60, 0.1);
}

.header .label {
  font-size: 22rpx;
  color: #f97316;
  font-weight: 600;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.date-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #292524;
}

.date-btn {
  font-size: 40rpx;
  color: #a8a29e;
  padding: 0 24rpx;
}

.stats {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #78716c;
}

.add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #fafaf9;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-add {
  background: #fff7ed;
  color: #c2410c;
}

.task-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.task-item.done .task-title {
  color: #a8a29e;
  text-decoration: line-through;
}

.check {
  font-size: 32rpx;
  color: #22c55e;
  line-height: 1.4;
}

.task-title {
  flex: 1;
  font-size: 30rpx;
  color: #292524;
  line-height: 1.5;
}

.empty {
  font-size: 28rpx;
  color: #78716c;
  text-align: center;
  display: block;
}

.loading {
  text-align: center;
  color: #a8a29e;
  font-size: 26rpx;
  padding: 48rpx;
}
