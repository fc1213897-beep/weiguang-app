/* 微光小程序 · 全局视觉 */

/**
 * 自定义 tabBar 占位（与 custom-tab-bar/index.wxss 同步）
 * inner: padding 24 + item 16 + icon 72 + text区 30 ≈ 142rpx
 * margin-bottom: 16rpx
 */
page {
  --mp-tab-bar-inner: 142rpx;
  --mp-tab-bar-margin: 16rpx;
  --mp-tab-bar-clearance: calc(
    var(--mp-tab-bar-inner) + var(--mp-tab-bar-margin) + env(safe-area-inset-bottom)
  );
  --mp-fab-size: 112rpx;
  --mp-fab-gap: 28rpx;
  --mp-fab-bottom: calc(var(--mp-tab-bar-clearance) + var(--mp-fab-gap));
  --mp-page-bottom: calc(var(--mp-fab-bottom) + var(--mp-fab-size) + 40rpx);

  /* 兼容旧变量名 */
  --tab-bar-clearance: var(--mp-tab-bar-clearance);
}

.page-wrap {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fffdf7;
}

.card-soft {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(251, 146, 60, 0.08);
  border: 1rpx solid rgba(254, 215, 170, 0.45);
}

.section-title {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #ea580c;
}

.btn-primary {
  background: linear-gradient(135deg, #fb923c 0%, #ea580c 100%) !important;
  color: #fff !important;
  border: none !important;
  border-radius: 999rpx !important;
  font-weight: 500 !important;
}

.btn-ghost {
  background: #fff7ed !important;
  color: #c2410c !important;
  border: none !important;
  border-radius: 999rpx !important;
}

/* 体验模式 / 登录提示条（各页复用） */
.guest-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border: 1rpx solid rgba(251, 146, 60, 0.35);
}

.guest-banner-text {
  flex: 1;
  font-size: 24rpx;
  color: #9a3412;
  line-height: 1.55;
}

.guest-banner-login {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #fb923c, #ea580c);
  border-radius: 999rpx;
}
