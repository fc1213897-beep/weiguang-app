/* 微光小程序 · 全局视觉 */
.page-wrap {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(165deg, #fff7ed 0%, #fffbeb 38%, #ffffff 100%);
}

.card-soft {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(251, 146, 60, 0.08);
  border: 1rpx solid rgba(254, 215, 170, 0.45);
}

.section-title {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #ea580c;
}

.btn-primary {
  background: linear-gradient(135deg, #fb923c 0%, #ea580c 100%) !important;
  color: #fff !important;
  border: none !important;
  border-radius: 999rpx !important;
  font-weight: 500 !important;
}

.btn-ghost {
  background: #fff7ed !important;
  color: #c2410c !important;
  border: none !important;
  border-radius: 999rpx !important;
}
